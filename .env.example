# 可选：注册邀请码。设置后注册页会出现邀请码输入框；不设置则开放注册
REGISTER_CODE=

# 可选：B 站登录 Cookie（服务器在海外被 B 站风控拦截 / HTTP 412 时填写）
# 浏览器登录 B 站 → F12 → 网络 → 任意请求 → 复制完整 Cookie 值（含 SESSDATA）
BILIBILI_COOKIE=

# 可选：Vercel Cron 调用 /api/cron 时校验的密钥（部署到 Vercel 后自动生成，一般无需手动填）
CRON_SECRET=

# 数据库连接串（本地开发用；Vercel 上由 Postgres 存储自动注入，无需配置）
# DATABASE_URL=postgres://user:password@host:5432/dbname
